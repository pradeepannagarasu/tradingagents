# Copy to .env and fill in. NEVER commit .env. Secrets are read only from the environment.

# --- core
TRIAGENT_MODE=PAPER                 # RESEARCH | PAPER | LIVE
LIVE_TRADING_ENABLED=false          # must ALSO be true in config, AND the dashboard "live disabled" flag cleared
RISK_SIGNING_KEY=                   # 64 hex chars: python -c "import secrets;print(secrets.token_hex(32))"
POSTGRES_PASSWORD=                  # used by docker compose
# DATABASE_URL=sqlite:///./data/triagent.db   # local default if unset
TRIAGENT_DEMO=false                 # true → loads a SIMULATED NIFTY series on first start

# --- LLM (optional; agents work deterministically without it)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=

# --- broker (not required for paper trading)
KITE_API_KEY=
KITE_API_SECRET=
KITE_ACCESS_TOKEN=

# --- notifications (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=

# --- Cloudflare deployment (docker-compose.cloudflare.yml). Values for your account are in docs/DEPLOYMENT.md.
CF_ACCESS_TEAM_DOMAIN=            # e.g. yourteam.cloudflareaccess.com (not secret)
CF_ACCESS_BACKEND_AUD=            # AUD tag of the markets-api Access app (not secret)
CF_ACCESS_SERVICE_TOKEN_ID=       # client id of the gateway service token (not secret; the secret stays in Pages)
ALLOWED_EMAILS=                   # e.g. you@example.com
DASHBOARD_ORIGIN=                 # e.g. https://markets.example.com
CLOUDFLARE_TUNNEL_TOKEN=          # SECRET — copy from Zero Trust → Networks → Tunnels → triagent → Configure
